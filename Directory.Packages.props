<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>
    <ItemGroup Label="Runtime Dependencies">
        <PackageVersion Include="Funcky" Version="3.8.0" />
        <PackageVersion Include="Pastel" Version="8.0.0" />
    </ItemGroup>
    <ItemGroup Label="Build Dependencies">
        <PackageVersion Include="Polyadic.CodeStyle" Version="1.2.3" />
        <PackageVersion Include="Funcky.Analyzers" Version="2.1.0" />
    </ItemGroup>
    <ItemGroup Label="Test Dependencies">
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
        <PackageVersion Include="Funcky.Xunit" Version="2.3.0" />
        <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    </ItemGroup>
</Project>